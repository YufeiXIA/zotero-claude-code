zcc-section-popout =
    .tooltiptext = Open in a separate window
zcc-menu-open-chat =
    .label = Claude Code Chat
zcc-menu-zotero-theme =
    .label = Warm Theme for Zotero
zcc-pref-zotero-theme =
    .label = Use the chat's warm color theme for all of Zotero
zcc-pref-title = Claude Code for Zotero
zcc-pref-claude-path = Claude Code executable
zcc-pref-claude-path-hint = Leave empty to detect it automatically.
zcc-pref-detect =
    .label = Detect
zcc-pref-model = Model
zcc-pref-model-hint = An alias (opus, sonnet, fable, haiku) or a full model name. The chat's model menu lists what your Claude Code offers.
zcc-pref-effort = Effort (optional: low, medium, high, xhigh, max)
zcc-pref-allowed-tools = Tools Claude may use without asking (comma separated)
