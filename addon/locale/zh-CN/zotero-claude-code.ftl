zcc-section-header =
    .label = Claude Code
zcc-section-sidenav =
    .tooltiptext = Claude Code
zcc-section-popout =
    .tooltiptext = 在独立窗口中打开
zcc-menu-open-chat =
    .label = Claude Code 对话
zcc-menu-zotero-theme =
    .label = Zotero 暖色主题
zcc-pref-zotero-theme =
    .label = 让整个 Zotero 也使用对话面板的暖色配色
zcc-pref-title = Claude Code for Zotero
zcc-pref-claude-path = Claude Code 可执行文件
zcc-pref-claude-path-hint = 留空则自动查找。
zcc-pref-detect =
    .label = 自动查找
zcc-pref-model = 模型
zcc-pref-model-hint = 可以填别名（opus、sonnet、fable、haiku）或完整模型名。对话里的模型菜单会列出你的 Claude Code 支持的模型。
zcc-pref-effort = 推理强度（可选：low、medium、high、xhigh、max）
zcc-pref-allowed-tools = 允许 Claude 直接使用的工具（逗号分隔）
zcc-pref-allowed-tools-hint = 默认只读。插件自带的 Zotero 工具（搜索文献库、读笔记和高亮）总是可用。如果装了 LLM for Zotero，可以再加上 mcp__zotero，让 Claude 使用它的 MCP 工具。
zcc-pref-allow-write =
    .label = 允许 Claude 在 Zotero 里写笔记、加高亮
zcc-pref-allow-write-hint = 和对话框里的铅笔按钮是同一个开关。只有你让它写的时候它才会写。
zcc-pref-user-settings =
    .label = 加载我的 Claude Code 用户设置（CLAUDE.md、MCP 服务器、权限规则）
zcc-pref-extra-prompt = 每次对话附加的说明
zcc-pref-follow-reader =
    .label = 对话自动切换到我正在读的论文
zcc-pref-custom-commands = 我的快捷操作（每行一条：名称 | 提示词）
zcc-pref-custom-commands-hint = 会显示为输入框上方的按钮，也会出现在 / 命令菜单里。
